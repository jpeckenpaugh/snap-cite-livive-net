{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1-dev"
    },
    "status": {
      "const": "development-not-qualified"
    },
    "engine": {
      "const": "0.1.0"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "enum": [
            "development-authored",
            "pending-review"
          ]
        }
      },
      "required": [
        "sha256",
        "source",
        "commit",
        "path",
        "redistribution"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "status",
    "engine",
    "schema_sha256",
    "rubric_sha256",
    "snapshot"
  ],
  "additionalProperties": false
}
