{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1-dev"
    },
    "touchstone": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "explicit-assertions-only"
        },
        "required_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "required": [
        "scope",
        "required_claims"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "member": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "member_type": {
            "enum": [
              "Property",
              "Function",
              "Event",
              "Callback"
            ]
          },
          "enum": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "item": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "span": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "start",
              "end",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "op",
          "span"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "touchstone",
    "source",
    "coverage",
    "assertions"
  ],
  "additionalProperties": false
}
